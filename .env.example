# APEX runtime configuration example.
# Copy to .env and fill in values appropriate for your environment.
# NEVER commit a real .env containing secrets.

# ---- Safety (hard defaults; do not weaken without explicit human approval) --
DRY_RUN=true
AUTO_EXECUTE=false
LIVE_TRADING_ENABLED=false

# ---- Webhook ---------------------------------------------------------------
# Required passphrase for the authenticated POST /webhook.
WEBHOOK_PASSPHRASE=

# ---- Ollama advisory (Phase 2) --------------------------------------------
# Local Ollama endpoint. The advisor is advisory-only; when unreachable the
# backend keeps running and AI_STATUS = DATA_UNAVAILABLE.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b