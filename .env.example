# ==============================================================================
# APEX 24/7 — Environment Configuration Template (.env.example)
# ==============================================================================
# INVARIANT: Production/live trading is permanently prohibited.
# Only PAPER, DRY_RUN, and SHADOW modes are permitted.
# ==============================================================================

# Execution Safety Controls
APEX_TRADING_MODE=PAPER
APEX_LIVE_TRADING_ENABLED=false

# Risk Limits (Hard ceilings enforced by Risk Guardian)
# Maximum equity risk per trade (e.g., 0.01 = 1.0%, hard ceiling = 0.05 / 5.0%)
APEX_MAX_RISK_PER_TRADE=0.01

# Maximum allowable leverage (e.g., 3.0, hard ceiling = 5.0)
APEX_MAX_LEVERAGE=3.0

# Maximum concurrent open positions (hard ceiling = 3)
APEX_MAX_CONCURRENT_POSITIONS=2

# Stop distance limits (as fraction of price, min 0.005 = 0.5%, max 0.03 = 3.0%)
APEX_MIN_STOP_DISTANCE_PCT=0.005
APEX_MAX_STOP_DISTANCE_PCT=0.03

# Cumulative daily drawdown threshold that trips Kill Switch (e.g., 0.03 = 3.0%)
APEX_DAILY_DRAWDOWN_KILL_PCT=0.03

# Maximum portfolio exposure across all open positions (1.50 = 150%)
APEX_MAX_EXPOSURE_PCT=1.50

# Staleness threshold before safety liquidation / close (milliseconds)
APEX_DANGER_STALE_THRESHOLD_MS=3600000

# Scanner & Market Universe
APEX_SYMBOLS=BTCUSDT,ETHUSDT

# API & Control Plane Server (Binds ONLY to localhost / 127.0.0.1 for security)
APEX_API_HOST=127.0.0.1
APEX_API_PORT=8000

# Telegram Bot Integration (Optional, for notifications and read-only commands)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789

# Binance Testnet Credentials (Optional, PAPER mode only)
# Never place production API keys here.
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=
